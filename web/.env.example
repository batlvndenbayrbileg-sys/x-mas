# Express API (Botxon/QPay invoices, legacy auth). next.config.js rewrites
# /api/* here — if this is wrong in production, CHECKOUT SILENTLY BREAKS.
API_URL=http://localhost:4001

# Medusa store API. Required at BUILD time too: next.config.js derives the CSP
# connect-src and next/image remotePatterns from it.
NEXT_PUBLIC_USE_MEDUSA=1
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9001
NEXT_PUBLIC_MEDUSA_PK=
NEXT_PUBLIC_MEDUSA_REGION=

# Set to 1 to route search through MeiliSearch (requires backend MEILISEARCH_HOST)
NEXT_PUBLIC_MEILISEARCH=0

# Public site origin (sitemap.xml / robots.txt / canonical). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://xmas.mn

# Analytics (optional; loaded only after cookie consent). Leave blank to disable.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Error monitoring (optional; blank = disabled)
NEXT_PUBLIC_SENTRY_DSN=
